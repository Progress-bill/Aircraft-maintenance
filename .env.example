# ==========================================
# Nero Aero - Environment Variables Reference
# ==========================================

# Node runtime environment (development | production)
NODE_ENV=production

# Server Port (Render sets this dynamically, defaults to 5000 locally, 10000 on Render)
PORT=10000

# JSON Web Token Secret Key (Used for cryptographic session verification)
# On Render: Auto-generated or paste a 32+ character random secret
JWT_SECRET=nero_aero_super_secure_jwt_secret_key_change_me_in_production_2026

# Database Path (Optional)
# Leave unset to use default SQLite database inside server directory (server/nero_aircraft.db)
# Or set to a persistent disk mount path, e.g., /var/data/nero_aircraft.db
DB_PATH=
